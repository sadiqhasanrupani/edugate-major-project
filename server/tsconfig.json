{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "removeComments": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ],
    "baseUrl": "./src",
    "paths": {
      "@config/*": [
        "config/*"
      ],
      "@app/contract/*": [
        "common/contracts/*"
      ],
      "@app/utils/*": [
        "common/utils/*"
      ],
      "@app/service/*": [
        "services/*"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
