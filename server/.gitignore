# ------------------------------------------------------------
# Node & Package Artifacts
# ------------------------------------------------------------
node_modules/
dist/
build/
.minio-data/
.cache/
.tmp/
.pnp/
.pnp.js
package-lock.json
yarn.lock
pnpm-lock.yaml

# ------------------------------------------------------------
# Environment Variables & Configs
# ------------------------------------------------------------
# Ignore local environment configs (keep template if needed)
.env
.env.local
.env.*.local
*.env

# Allow example/template env file for onboarding
!/.env.example

# ------------------------------------------------------------
# Testing & Coverage
# ------------------------------------------------------------
coverage/
.vitest/
jest-cache/
jest-report/

# ------------------------------------------------------------
# Logs & Diagnostics
# ------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ------------------------------------------------------------
# IDE / Editor Files
# ------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------
# OS & Miscellaneous
# ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo

# ------------------------------------------------------------
# Public / Static Assets
# ------------------------------------------------------------
# Ignore all public assets EXCEPT essential placeholders
/public/*
!/public/images/
/public/images/*

# Keep important placeholder or branding images
!/public/images/user-profile-img/
!/public/images/user-profile-img/user-placeholder.png

# ------------------------------------------------------------
# Compiled / Generated Files
# ------------------------------------------------------------
*.out
*.map
*.min.js
*.min.css

# ------------------------------------------------------------
# TypeScript & Build Artifacts
# ------------------------------------------------------------
*.tsbuildinfo
*.d.ts
.next/
out/
.nyc_output/

# ------------------------------------------------------------
# Local Runtime Files
# ------------------------------------------------------------
minio-data/
uploads/
tmp/
logs/
sessions/

# ------------------------------------------------------------
# Lock or Cache Files
# ------------------------------------------------------------
package-lock.json
yarn.lock
npm-shrinkwrap.json
