{
  "name": "server",
  "version": "1.0.0",
  "description": "This is a server of our edugate webapp. Here we will communicate between client and database.",
  "main": "app.js",
  "scripts": {
    "build": "npx tsc",
    "start:dev": "NODE_ENV=development tsc && NODE_ENV=development nodemon dist/app.js",
    "start": "NODE_ENV=production node dist/app.js",
    "watch": "rimraf ./dist && npx tsc --watch",
    "db:push": "npm run push:dev && npm run db:seed",
    "db:seed": "node scripts/seed-db.js",
    "db:seed:test": "DB_PATH=./database/sqlite-test.db node scripts/seed-db.js",
    "push:dev": "NODE_ENV=development npx drizzle-kit push",
    "push:test": "NODE_ENV=testing npx drizzle-kit push",
    "push": "npx drizzle-kit push"
  },
  "keywords": [],
  "author": "Sadiqhasan Rupani",
  "license": "ISC",
  "dependencies": {
    "@types/rimraf": "^4.0.5",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.38.1",
    "express": "^4.18.2",
    "express-validator": "^6.14.3",
    "handlebars": "^4.7.7",
    "imagemin": "^8.0.1",
    "jsonwebtoken": "^9.0.0",
    "minio": "^8.0.6",
    "module-alias": "^2.2.3",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "nanoid": "^3.1.23",
    "nodemailer": "^6.9.1",
    "react-pdf": "^6.2.2",
    "rimraf": "^6.0.1",
    "sequelize": "^6.28.0",
    "serve-static": "^1.15.0",
    "sharp": "^0.32.1",
    "typescript": "^4.9.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.13",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.16",
    "@types/express-validator": "^3.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/imagemin": "^8.0.1",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/minio": "^7.1.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.7",
    "@types/mysql": "^2.15.21",
    "@types/nanoid": "^3.0.0",
    "@types/node": "^18.11.18",
    "@types/nodemailer": "^6.4.7",
    "@types/nodemon": "^1.19.2",
    "@types/sequelize": "^4.28.14",
    "@types/serve-static": "^1.15.1",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^9.0.0",
    "drizzle-kit": "^0.30.0",
    "nodemon": "^2.0.20",
    "socket.io": "^4.6.1",
    "tsconfig-paths": "^4.2.0"
  },
  "_moduleAliases": {
    "@app/contract": "dist/common/contracts",
    "@app/utils": "dist/common/utils",
    "@app/service": "dist/services",
    "@config": "dist/config"
  }
